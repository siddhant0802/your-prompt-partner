# TheProjectWork — environment template
# Copy to .env and fill in REAL values before building. Never commit .env.
# Every value below must come from the SAME Supabase project.

# ---- Backend (your own Supabase project) -------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your publishable / anon key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# Server-side copies of the same backend (used by server functions)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your publishable / anon key>

# Privileged key — server only. NEVER put this in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=<your service_role key>

# ---- Payments (Razorpay, server only) ----------------------------------------
RAZORPAY_KEY_ID=<rzp_test_... for testing, rzp_live_... only with owner approval>
RAZORPAY_KEY_SECRET=<your Razorpay key secret>
RAZORPAY_WEBHOOK_SECRET=<your Razorpay webhook secret>
# Set to true ONLY to allow live keys after owner approval:
# RAZORPAY_ALLOW_LIVE=true

# ---- AI assistant (server only) ----------------------------------------------
LOVABLE_API_KEY=<your AI gateway key>
